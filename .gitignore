# CUDA CTranslate2 source + build tree (~11 GB, regenerated by install.sh)
ct2/CTranslate2/

# Built wheels: ~40 MB aarch64/cp310/CUDA binaries, useless on any other machine and
# rebuilt in minutes from the installed C++ library. They stay on the device that
# built them (and pack.sh still carries them), they do not belong in git history.
ct2/wheels/

# Whisper weights (~1 GB) -- fetched by install.sh / download_model.py
transcriber/models/

# Recorded sessions: audio and transcripts of real people
transcriber/sessions/

# Logs and run artifacts
transcriber/logs/
emotion_analysis/results/

# Exported emotion model: emotion_deploy/ IS tracked, its *.onnx through Git LFS
# (see .gitattributes). Stray or partial copies inside the Python package are not.
emotion_model/*.onnx
emotion_model/deploy.json
emotion_model/merges.txt
emotion_model/vocab.json
emotion_model/tokenizer*.json
emotion_model/special_tokens_map.json

# Raw Slurm/console logs of training runs carry the cluster's user name, home paths and
# job ids; the metrics, predictions and configs next to them are kept.
pipeline/results/*/seed*.log
pipeline/logs/

# Virtualenvs and interpreter markers
.venv/
.venv.broken/
*/.venv/
*/.venv.broken/
.venv_path
*/.venv_path
pipeline/.data_root

# Caches
.hf_cache/
*/.hf_cache/
__pycache__/
*.py[cod]
.pytest_cache/
.ipynb_checkpoints/

# Packaged tarballs and diagnostics bundles (they may contain transcripts)
Emote-*.tar.gz
diagnostics_*.tar.gz

# OS noise
.DS_Store

# Private working notes: machine names, addresses and paths
CLAUDE.md
HANDOFF_*.md
.claude/
